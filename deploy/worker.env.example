# Copy to /etc/unitrade/worker.env, make it readable only by the unitrade user,
# and replace every placeholder. Never commit the real file to GitHub.
APP_ENCRYPTION_KEY=replace-with-a-fernet-key
UNITRADE_DB_PATH=/var/lib/unitrade/unitrade_users.db
BOT_POLL_SECONDS=30
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=smtp-username
SMTP_PASSWORD=smtp-password
SMTP_FROM=UniTrade <no-reply@example.com>
SMTP_USE_TLS=true
