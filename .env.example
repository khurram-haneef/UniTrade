# Copy this file to .env on the VPS. Do not commit the real .env file.
APP_ENCRYPTION_KEY=replace-with-a-fernet-key
DATABASE_URL=
UNITRADE_DB_PATH=/var/lib/unitrade/unitrade_users.db

# Set false to create verified accounts immediately without SMTP.
REQUIRE_EMAIL_VERIFICATION=false

# Configure these values and set REQUIRE_EMAIL_VERIFICATION=true to enable OTP email verification.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=smtp-username
SMTP_PASSWORD=smtp-password
SMTP_SENDER=UniTrade <no-reply@example.com>
SMTP_USE_TLS=true
